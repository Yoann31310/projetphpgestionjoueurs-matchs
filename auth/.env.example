# Copier ce fichier en ".env" puis adapter les valeurs. Le fichier .env ne doit JAMAIS être envoyé sur Git.

# Base de données du service d'authentification
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=equipe_sport_auth
DB_USER=equipe_sport
DB_PASSWORD=changez-moi

# Secret qui signe les jetons (32 caractères minimum). Exemple pour en générer un : php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=remplacez-par-une-longue-valeur-aleatoire-unique

# Durée de vie d'un jeton, en secondes (1800 = 30 minutes)
JWT_TTL=1800

# Sites autorisés à appeler l'API depuis un navigateur (séparés par des virgules). Vide = aucun.
ALLOWED_ORIGIN=
