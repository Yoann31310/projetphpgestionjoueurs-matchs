# Copier ce fichier en ".env" (à côté de ce fichier, hors du dossier src) puis adapter les valeurs.
# Le fichier .env ne doit JAMAIS être envoyé sur Git.

# Adresse de l'API d'authentification
AUTH_API_URL=http://127.0.0.1:8001/authapi.php

# Adresse de base des API de gestion (joueurs, matchs, feuilles de match, statistiques)
GESTION_API_URL=http://127.0.0.1:8002
