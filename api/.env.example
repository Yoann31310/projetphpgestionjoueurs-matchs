# Copier ce fichier en ".env" puis adapter les valeurs. Le fichier .env ne doit JAMAIS être envoyé sur Git.

# Base de données du service de gestion (joueurs, matchs, feuilles de match)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=equipe_sport_gestion
DB_USER=equipe_sport
DB_PASSWORD=changez-moi

# Adresse de l'API d'authentification (elle vérifie chaque jeton reçu)
AUTH_API_URL=http://127.0.0.1:8001/authapi.php

# Sites autorisés à appeler l'API depuis un navigateur (séparés par des virgules). Vide = aucun.
ALLOWED_ORIGIN=
