# Les fichiers internes ne doivent pas être accessibles depuis le navigateur
Options -Indexes
<FilesMatch "^(\.env.*|config\.php|.*\.sql|.*\.md|.*\.example)$">
    Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(DAO|Classes|Modeles)/ - [F,L]
</IfModule>
